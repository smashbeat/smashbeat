# Local SQLite file. Override with Postgres in production.
DATABASE_URL="file:./dev.db"

# Meta (Facebook) Marketing API. Create an app at https://developers.facebook.com/apps
# Required products: Facebook Login + Marketing API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# Public base URL of this app
APP_BASE_URL="http://localhost:3000"

# 32-byte key for encrypting stored access tokens at rest.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
